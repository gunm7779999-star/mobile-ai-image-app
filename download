'use client';

import { useEffect, useMemo, useState } from 'react';

type ImageStyle = 'cinematic' | 'anime' | 'realistic' | 'product' | 'sns';
type ImageSize = 'square' | 'portrait' | 'landscape';

type GeneratedImage = {
  id: number;
  prompt: string;
  style: ImageStyle;
  size: ImageSize;
  createdAt: string;
};

const styleLabels: Record<ImageStyle, string> = {
  cinematic: 'シネマ風',
  anime: 'アニメ風',
  realistic: 'リアル写真風',
  product: '商品広告風',
  sns: 'SNSカード風',
};

const sizeLabels: Record<ImageSize, string> = {
  square: '1:1 正方形',
  portrait: '9:16 縦長',
  landscape: '16:9 横長',
};

const aspectClasses: Record<ImageSize, string> = {
  square: 'aspect-square',
  portrait: 'aspect-[9/16]',
  landscape: 'aspect-video',
};

const styleIcons: Record<ImageStyle, string> = {
  cinematic: '🎬',
  anime: '✨',
  realistic: '📷',
  product: '🛍️',
  sns: '📱',
};

const samplePrompts = [
  '近未来の東京、雨上がりの夜景、ネオン、映画ポスター風',
  '株式投資アプリの広告画像、青基調、信頼感、スマホ画面',
  '白い背景の商品写真、高級感のある腕時計、自然光',
];

export default function Home() {
  const [prompt, setPrompt] = useState('');
  const [style, setStyle] = useState<ImageStyle>('cinematic');
  const [size, setSize] = useState<ImageSize>('portrait');
  const [count, setCount] = useState(2);
  const [images, setImages] = useState<GeneratedImage[]>([]);
  const [isGenerating, setIsGenerating] = useState(false);

  useEffect(() => {
    const saved = window.localStorage.getItem('mobile-ai-image-app:last-prompt');
    if (saved) setPrompt(saved);
  }, []);

  useEffect(() => {
    window.localStorage.setItem('mobile-ai-image-app:last-prompt', prompt);
  }, [prompt]);

  const canGenerate = prompt.trim().length >= 6 && !isGenerating;

  const promptHint = useMemo(() => {
    if (prompt.length === 0) return 'どんな画像を作りたいか入力してください';
    if (prompt.length < 6) return 'もう少し具体的に書くと精度が上がります';
    return '生成準備OK。API接続後はここから画像生成します';
  }, [prompt.length]);

  function handleGenerate() {
    if (!canGenerate) return;
    setIsGenerating(true);
    window.setTimeout(() => {
      const now = new Date().toLocaleString('ja-JP');
      const next = Array.from({ length: count }, (_, index) => ({
        id: Date.now() + index,
        prompt: prompt.trim(),
        style,
        size,
        createdAt: now,
      }));
      setImages(next);
      setIsGenerating(false);
    }, 650);
  }

  return (
    <main className="phone-frame mx-auto flex w-full max-w-md flex-col px-4 pt-5 sm:px-6">
      <header className="mb-5 flex items-center justify-between">
        <div>
          <p className="text-xs font-semibold uppercase tracking-[0.32em] text-indigo-500">MVP Preview</p>
          <h1 className="mt-2 text-3xl font-black tracking-tight text-slate-950">AI Image Lab</h1>
          <p className="mt-1 text-sm text-slate-600">スマホ優先の画像生成UI。今はダミー表示です。</p>
        </div>
        <div className="grid h-12 w-12 place-items-center rounded-2xl bg-slate-950 text-2xl shadow-soft">🖼️</div>
      </header>

      <section className="rounded-[2rem] border border-white/70 bg-white/78 p-4 shadow-soft backdrop-blur">
        <label className="text-sm font-bold text-slate-800" htmlFor="prompt">作りたい画像の説明</label>
        <textarea
          id="prompt"
          value={prompt}
          onChange={(event) => setPrompt(event.target.value)}
          placeholder="例：近未来の日本株トレードアプリ広告、青と紫、スマホ画面、立体的なグラフ"
          className="mt-3 h-32 w-full rounded-3xl border border-slate-200 bg-slate-50 px-4 py-4 text-base leading-7 outline-none transition focus:border-indigo-400 focus:bg-white focus:ring-4 focus:ring-indigo-100"
        />
        <p className="mt-2 text-xs text-slate-500">{promptHint}</p>

        <div className="mt-4 grid gap-3">
          <OptionSelect
            label="画像スタイル"
            value={style}
            onChange={(value) => setStyle(value as ImageStyle)}
            options={Object.entries(styleLabels)}
          />
          <OptionSelect
            label="サイズ"
            value={size}
            onChange={(value) => setSize(value as ImageSize)}
            options={Object.entries(sizeLabels)}
          />
          <div>
            <p className="mb-2 text-sm font-bold text-slate-800">枚数</p>
            <div className="grid grid-cols-3 gap-2">
              {[1, 2, 4].map((item) => (
                <button
                  key={item}
                  type="button"
                  onClick={() => setCount(item)}
                  className={`rounded-2xl border px-4 py-3 text-sm font-bold transition ${
                    count === item
                      ? 'border-slate-950 bg-slate-950 text-white shadow-lg'
                      : 'border-slate-200 bg-white text-slate-700'
                  }`}
                >
                  {item}枚
                </button>
              ))}
            </div>
          </div>
        </div>

        <button
          type="button"
          onClick={handleGenerate}
          disabled={!canGenerate}
          className="mt-5 w-full rounded-3xl bg-gradient-to-r from-slate-950 to-indigo-700 px-5 py-4 text-base font-black text-white shadow-soft transition active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-40"
        >
          {isGenerating ? '生成中...' : 'ダミー画像を生成'}
        </button>
      </section>

      <section className="mt-5 rounded-[2rem] border border-white/70 bg-white/60 p-4 backdrop-blur">
        <div className="mb-3 flex items-center justify-between">
          <h2 className="text-lg font-black text-slate-950">生成結果</h2>
          <span className="rounded-full bg-indigo-100 px-3 py-1 text-xs font-bold text-indigo-700">API未接続</span>
        </div>

        {images.length === 0 ? (
          <div className="rounded-3xl border border-dashed border-slate-300 bg-white/70 p-5 text-center text-sm text-slate-500">
            生成ボタンを押すと、ここにダミー画像カードが表示されます。
            <div className="mt-4 grid gap-2 text-left">
              {samplePrompts.map((item) => (
                <button
                  key={item}
                  type="button"
                  onClick={() => setPrompt(item)}
                  className="rounded-2xl bg-slate-50 px-3 py-3 text-xs font-semibold text-slate-600"
                >
                  {item}
                </button>
              ))}
            </div>
          </div>
        ) : (
          <div className="grid gap-4">
            {images.map((image, index) => (
              <article key={image.id} className="overflow-hidden rounded-[1.75rem] border border-white bg-white shadow-soft">
                <div className={`generated-card ${aspectClasses[image.size]} grid place-items-center p-5`}>
                  <div className="text-center">
                    <div className="mx-auto grid h-16 w-16 place-items-center rounded-3xl bg-white/80 text-4xl shadow-lg">
                      {styleIcons[image.style]}
                    </div>
                    <p className="mt-4 rounded-full bg-slate-950/80 px-4 py-2 text-xs font-black text-white">
                      Dummy Image #{index + 1}
                    </p>
                  </div>
                </div>
                <div className="p-4">
                  <div className="mb-2 flex flex-wrap gap-2">
                    <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">{styleLabels[image.style]}</span>
                    <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">{sizeLabels[image.size]}</span>
                  </div>
                  <p className="line-clamp-3 text-sm font-semibold leading-6 text-slate-700">{image.prompt}</p>
                  <p className="mt-2 text-xs text-slate-400">{image.createdAt}</p>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      <footer className="mt-5 text-center text-xs text-slate-500">
        Next.js + TypeScript + Tailwind CSS / future OpenAI Images API ready
      </footer>
    </main>
  );
}

function OptionSelect({
  label,
  value,
  onChange,
  options,
}: {
  label: string;
  value: string;
  onChange: (value: string) => void;
  options: [string, string][];
}) {
  return (
    <label className="block">
      <span className="mb-2 block text-sm font-bold text-slate-800">{label}</span>
      <select
        value={value}
        onChange={(event) => onChange(event.target.value)}
        className="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-700 outline-none focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100"
      >
        {options.map(([key, text]) => (
          <option key={key} value={key}>{text}</option>
        ))}
      </select>
    </label>
  );
}
